---
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";

interface Props {
  src: string;
  alt: string;
}

const allContentImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/posts/**/*.{jpg,jpeg,png}"
);

const result = Object.entries(allContentImages).find(([path]) => {
  return decodeURIComponent(Astro.props.src.slice(5)) === path.slice(5);
});
if (result === undefined) {
  throw new Error("Couldn't find the image");
}

const matchingResolvedImage = result[1];
const resolved = await matchingResolvedImage();
const fullSizeImage = await getImage({ src: resolved.default, width: 2400 });
---

<figure>
  <a
    class="lightbox cursor-pointer"
    href={fullSizeImage.src}
    data-pswp-width={fullSizeImage.attributes.width}
    data-pswp-height={fullSizeImage.attributes.height}
    target="_blank"
  >
    <Image
      src={matchingResolvedImage()}
      alt={Astro.props.alt}
      widths={[800, 1200]}
      sizes="(max-width: 900px) 100vw, 900px"
      class="m-0"
    />
  </a>

  <figcaption>
    {Astro.props.alt}
  </figcaption>
</figure>
